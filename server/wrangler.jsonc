{
  "name": "tam-os-store",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tam-os-store-db",
      "database_id": "01223c4d-39c7-46fd-8985-4217da21df76"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "talebahmadc-prog",
    "GITHUB_REPO": "tam-os-updates",
    "GITHUB_BRANCH": "main",
    "SESSION_TTL_SECONDS": "43200",
    "LICENSING_URL": "https://neta-licensing.netau.workers.dev"
  },
  // Service binding to the licensing Worker (same account). A plain fetch to its
  // workers.dev URL is blocked (Cloudflare error 1042); this binding calls it
  // directly. The store uses only its /api/reseller/login endpoint — no DB access.
  "services": [
    { "binding": "LICENSING", "service": "neta-licensing" }
  ]
  // Secret (never in vars): the GitHub token used to commit JSON and upload
  // APKs to Releases. Set it with:
  //   wrangler secret put GITHUB_TOKEN
}
